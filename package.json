    "start": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/express": "^2.28.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.2.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
