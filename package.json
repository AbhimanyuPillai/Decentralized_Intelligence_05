{
  "name": "agent-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marketplace directory and ledger for the pay-per-call agent economy hackathon.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
