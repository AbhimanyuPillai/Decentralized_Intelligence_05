{
  "contractVersion": "1.3.0",
  "description": "Shared application contract for the agent marketplace. x402 wire payloads and signatures must be handled by the official x402 v2 SDK, not hand-authored here.",
  "conventions": {
    "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
    "currency": "USDC",
    "assetDecimals": 6,
    "moneyRule": "priceUnits and budgetUnits are canonical integer strings. Convert to display USDC by dividing by 1000000; do not use floating-point values for budget or payment arithmetic.",
    "timestamps": "ISO 8601 UTC date-time strings except fields explicitly named timestampMs.",
    "replaceBeforeUse": "Replace all REPLACE_ME endpoint and wallet values with the deployed HTTPS URLs and real testnet addresses. Never store private keys here."
  },
  "environment": {
    "network": "eip155:84532",
    "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
    "facilitatorUrl": "https://x402.org/facilitator",
    "rpcUrl": "https://sepolia.base.org",
    "explorerTransactionUrlTemplate": "https://sepolia.basescan.org/tx/{txHash}",
    "paymentScheme": "exact"
  },
  "sellerListingSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SellerListing",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "enum": [
          "scraping",
          "data",
          "inference"
        ]
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "endpointUrl": {
        "type": "string"
      },
      "priceUnits": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "paymentRequired": {
        "type": "boolean"
      },
      "ready": {
        "type": "boolean"
      },
      "readinessReason": {
        "type": "string"
      },
      "selectionScore": {
        "type": "number",
        "minimum": 0
      },
      "trustStatus": { "type": "string", "enum": ["unproven", "active", "quarantined", "blacklisted"] },
      "demoScamType": { "type": "string", "enum": ["price_mismatch", "recipient_mismatch"] },
      "demoReplayRole": { "type": "string", "enum": ["first", "second"] },
      "demoFailureType": { "type": "string", "enum": ["compute_error"] },
      "rankingFactors": {
        "type": "object",
        "properties": {
          "legitimacy": { "type": "number", "minimum": 0, "maximum": 100 },
          "success": { "type": "number", "minimum": 0, "maximum": 100 },
          "availability": { "type": "number", "minimum": 0, "maximum": 100 },
          "latency": { "type": "number", "minimum": 0, "maximum": 100 },
          "cost": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "required": ["legitimacy", "success", "availability", "latency", "cost"],
        "additionalProperties": false
      },
      "network": {
        "type": "string",
        "const": "eip155:84532"
      },
      "asset": {
        "type": "string",
        "const": "0x036CbD53842c5426634e7929541eC2318f3dCF7e"
      },
      "payTo": {
        "type": "string",
        "pattern": "^0x[a-fA-F0-9]{40}$"
      },
      "escrow": {
        "type": "object",
        "description": "Present when buyers pay the marketplace escrow wallet. payTo is then the escrow wallet; the escrow releases to sellerPayTo on acceptance or after holdSeconds, or refunds the buyer when a dispute is upheld.",
        "properties": {
          "sellerPayTo": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "holdSeconds": { "type": "integer", "minimum": 10, "maximum": 86400 }
        },
        "required": ["sellerPayTo", "holdSeconds"],
        "additionalProperties": false
      },
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {
        "type": "object"
      },
      "reputation": {
        "type": "object",
        "properties": {
          "totalCalls": {
            "type": "integer",
            "minimum": 0
          },
          "successfulCalls": {
            "type": "integer",
            "minimum": 0
          },
          "successRatePercent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "medianLatencyMs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "availabilityPercent": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100
          },
          "mismatchCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "totalCalls",
          "successfulCalls",
          "successRatePercent",
          "medianLatencyMs"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "name",
      "category",
      "description",
      "endpointUrl",
      "priceUnits",
      "network",
      "asset",
      "payTo",
      "inputSchema",
      "outputSchema",
      "reputation"
    ],
    "additionalProperties": false
  },
  "sellers": [
    {
      "id": "shelf-scraper",
      "name": "Shelf Scraper Agent",
      "category": "scraping",
      "description": "Scrapes one Books to Scrape catalogue page, follows book detail links, and returns title, GBP price, star rating, and description text.",
      "endpointUrl": "https://REPLACE_ME/sellers/shelf-scraper/scrape",
      "priceUnits": "2000",
      "network": "eip155:84532",
      "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
      "payTo": "0xA360194De2Ff897C0fE441890FdC7DD045DE49b2",
      "escrow": { "sellerPayTo": "0xD0a2c0d5886B5B49CA39116816613a007C246F8b", "holdSeconds": 600 },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "page"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "books": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "priceGbp": {
                  "type": "number",
                  "minimum": 0
                },
                "stars": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "priceGbp",
                "stars",
                "description"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "page",
          "books"
        ],
        "additionalProperties": false
      },
      "reputation": {
        "totalCalls": 0,
        "successfulCalls": 0,
        "successRatePercent": null,
        "medianLatencyMs": null
      }
    },
    {
      "id": "fx-rates",
      "name": "FX Rates Agent",
      "category": "data",
      "description": "Returns a sourced GBP-to-INR exchange rate and the time it was observed.",
      "endpointUrl": "https://REPLACE_ME/sellers/fx-rates/rate",
      "priceUnits": "1000",
      "network": "eip155:84532",
      "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
      "payTo": "0xA360194De2Ff897C0fE441890FdC7DD045DE49b2",
      "escrow": { "sellerPayTo": "0xD0a2c0d5886B5B49CA39116816613a007C246F8b", "holdSeconds": 600 },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "const": "GBP"
          },
          "to": {
            "type": "string",
            "const": "INR"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "const": "GBP"
          },
          "to": {
            "type": "string",
            "const": "INR"
          },
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to",
          "rate",
          "timestamp",
          "source"
        ],
        "additionalProperties": false
      },
      "reputation": {
        "totalCalls": 0,
        "successfulCalls": 0,
        "successRatePercent": null,
        "medianLatencyMs": null
      }
    },
    {
      "id": "hindi-summary",
      "name": "Hindi Summary Agent",
      "category": "inference",
      "description": "Produces concise Hindi summaries for one or two supplied book descriptions per request.",
      "endpointUrl": "https://REPLACE_ME/sellers/hindi-summary/summarise",
      "priceUnits": "10000",
      "network": "eip155:84532",
      "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
      "payTo": "0xA360194De2Ff897C0fE441890FdC7DD045DE49b2",
      "escrow": { "sellerPayTo": "0xD0a2c0d5886B5B49CA39116816613a007C246F8b", "holdSeconds": 600 },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 2
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "summaries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "summary"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 2
          }
        },
        "required": [
          "summaries"
        ],
        "additionalProperties": false
      },
      "reputation": {
        "totalCalls": 0,
        "successfulCalls": 0,
        "successRatePercent": null,
        "medianLatencyMs": null
      }
    }
  ],
  "buyerTaskSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "BuyerTask",
    "type": "object",
    "properties": {
      "taskId": {
        "type": "string",
        "minLength": 1
      },
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "budgetUnits": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "network": {
        "type": "string",
        "const": "eip155:84532"
      },
      "maxConcurrency": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    },
    "required": [
      "taskId",
      "prompt",
      "budgetUnits",
      "network",
      "maxConcurrency"
    ],
    "additionalProperties": false
  },
  "exampleBuyerTask": {
    "taskId": "books-five-star-hindi",
    "prompt": "From pages 1 to 4 of books.toscrape.com, find the three cheapest 5-star books, give their prices in rupees, and summarize each description in Hindi.",
    "budgetUnits": "50000",
    "network": "eip155:84532",
    "maxConcurrency": 3
  },
  "ledgerRecordSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "LedgerRecord",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "taskId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "buyerAddress": {
        "type": "string",
        "pattern": "^0x[a-fA-F0-9]{40}$"
      },
      "sellerId": {
        "type": "string",
        "minLength": 1
      },
      "serviceName": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "enum": [
          "scraping",
          "data",
          "inference"
        ]
      },
      "listedPriceUnits": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "askedPriceUnits": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "amountPaidUnits": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "txHash": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^0x[a-fA-F0-9]{64}$"
      },
      "chainVerified": {
        "type": "boolean"
      },
      "explorerUrl": {
        "type": [
          "string",
          "null"
        ],
        "format": "uri"
      },
      "status": {
        "type": "string",
        "enum": [
          "paid",
          "paid, output rejected",
          "completed free",
          "settlement unknown",
          "refused",
          "failed and not charged"
        ]
      },
      "latencyMs": {
        "type": "integer",
        "minimum": 0
      },
      "reason": {
        "type": "string"
      },
      "sellerResponded": {
        "type": "boolean"
      },
      "scamMismatch": {
        "type": "string",
        "enum": ["price_mismatch", "recipient_mismatch"]
      },
      "observedChallenge": {
        "type": "object",
        "properties": {
          "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
          "network": { "type": "string" },
          "asset": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "payTo": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" }
        },
        "required": ["amount", "network", "asset", "payTo"],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "taskId",
      "timestamp",
      "buyerAddress",
      "sellerId",
      "serviceName",
      "category",
      "listedPriceUnits",
      "askedPriceUnits",
      "amountPaidUnits",
      "txHash",
      "explorerUrl",
      "status",
      "latencyMs"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "paid",
                "paid, output rejected"
              ]
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "properties": {
            "chainVerified": {
              "const": true
            }
          },
          "required": [
            "chainVerified"
          ]
        }
      }
    ],
    "statusInvariants": {
      "paid": "amountPaidUnits > 0, txHash/explorerUrl identify the real settlement, and chainVerified is true after Marketplace receipt and USDC transfer verification.",
      "paid, output rejected": "amountPaidUnits > 0, txHash/explorerUrl identify the real settlement, and chainVerified is true after Marketplace receipt and USDC transfer verification.",
      "completed free": "amountPaidUnits is 0 and txHash/explorerUrl are null; only valid for a free test-mode listing.",
      "settlement unknown": "amountPaidUnits is 0 and txHash/explorerUrl are null; a payment was signed but settlement could not be verified, so the call must not be retried automatically.",
      "refused": "amountPaidUnits is 0 and txHash/explorerUrl are null.",
      "failed and not charged": "amountPaidUnits is 0 and txHash/explorerUrl are null."
    }
  },
  "paymentChecks": {
    "protocol": "Use the official x402 v2 SDK for payment headers, payloads, signing, verification, and settlement. Do not hand-build or modify signed payloads.",
    "beforeSigning": [
      "The selected scheme is exact.",
      "The asked amount is a non-negative integer string and exactly equals the registry priceUnits.",
      "The asked network matches the seller listing and configured network.",
      "The asked asset matches the seller listing and configured asset.",
      "The asked payTo address matches the seller listing payTo address, case-insensitively."
    ],
    "escrow": "When a listing has escrow terms, its payTo is the marketplace escrow wallet (0xA360194De2Ff897C0fE441890FdC7DD045DE49b2) and buyers pay that wallet. The escrow releases the payment to escrow.sellerPayTo when the buyer accepts or holdSeconds pass without a dispute, and refunds the buyer when a dispute is upheld. Buyers accept or dispute with a verdict signed by the paying wallet.",
    "budgetReservationRule": "Atomically require spentUnits + reservedUnits + callPriceUnits <= budgetUnits before starting a call. On settlement, move the reservation to spent; on confirmed failure without settlement, release it.",
    "replayRule": "Consume each signed authorization at most once. Use atomic persistent/shared idempotency and replay state; an in-memory set alone is insufficient."
  },
  "sellerSafety": {
    "trustStatuses": ["unproven", "active", "quarantined", "blacklisted"],
    "newSeller": "Starts as unproven with zero completed calls, no reputation score, and neutral ranking factors.",
    "mismatchRules": {
      "price_mismatch": "Observed x402 amount differs from the registered price; refuse before signing and quarantine the seller.",
      "recipient_mismatch": "Observed x402 payTo differs from the registered recipient; refuse before signing and quarantine the seller.",
      "repeat": "A second distinct trusted Scout finding blacklists the seller. Only an administrator may reinstate it after review."
    },
    "rankingWeights": {
      "legitimacy": 0.4,
      "successfulCompletion": 0.25,
      "availability": 0.15,
      "latency": 0.1,
      "listedCost": 0.1
    },
    "demoSellers": [
      { "id": "demo-price-inflator", "scamMismatch": "price_mismatch", "listedPriceUnits": "2000", "requestedPriceUnits": "20000" },
      { "id": "demo-recipient-switch", "scamMismatch": "recipient_mismatch", "listedPriceUnits": "2000", "requestedPayTo": "A different address from the listing" },
      { "id": "demo-receipt-first", "demoReplayRole": "first", "priceUnits": "2000" },
      { "id": "demo-receipt-second", "demoReplayRole": "second", "priceUnits": "2000" }
    ],
    "receiptReplayRule": "Bind each signed authorization fingerprint to the first service that claims it. Reject reuse on every other service. Retry a confirmed uncharged failure only on the original service; never retry settled or uncertain authorizations.",
    "findingTrust": "A safety finding requires a private Scout-to-Marketplace report token and structured observed challenge values; caller-supplied reason text alone is not evidence."
  },
  "exampleTaskCostPlan": {
    "scrapingCalls": 4,
    "scrapingPriceUnitsEach": "2000",
    "dataCalls": 1,
    "dataPriceUnitsEach": "1000",
    "inferenceCalls": 2,
    "inferencePriceUnitsEach": "10000",
    "estimatedTotalUnits": "29000",
    "budgetUnits": "50000",
    "remainingUnits": "21000",
    "note": "Estimate only; calculate actual spend using live listings and accepted quotes."
  }
}
