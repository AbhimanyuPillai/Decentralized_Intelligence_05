PORT=4000
BUYER_ORIGIN=http://localhost:3001

# Free local testing by default. Set to true to require x402 payments.
SELLER_PAYMENTS_ENABLED=false

# Public Base Sepolia address that receives the movie seller's USDC payments.
MOVIE_SCRAPER_PAY_TO=
MOVIE_FACTS_PAY_TO=
MOVIE_SUMMARY_PAY_TO=
SHELF_SCRAPER_PAY_TO=
FX_RATES_PAY_TO=
HINDI_SUMMARY_PAY_TO=
FAKEJOBS_SCRAPER_PAY_TO=
FAKEJOBS_FACTS_PAY_TO=
FAKEJOBS_SUMMARY_PAY_TO=

# Optional when all built-in agents should receive into one seller wallet.
SELLER_PRIVATE_KEY=

# OpenAI-compatible chat-completions endpoint for the Hindi inference seller.
MOVIE_SUMMARY_API_URL=
MOVIE_SUMMARY_API_KEY=
MOVIE_SUMMARY_MODEL=
BOOK_SUMMARY_API_URL=
BOOK_SUMMARY_API_KEY=
BOOK_SUMMARY_MODEL=
JOB_SUMMARY_API_URL=
JOB_SUMMARY_API_KEY=
JOB_SUMMARY_MODEL=

# Set this to the public HTTPS origin from your tunnel when another computer needs
# to call the seller. Leave blank for same-computer testing.
PUBLIC_BASE_URL=

# Scout buyer execution settings. Keep the buyer key private and use a low-balance
# Base Sepolia test wallet only. Leave the key blank for free local test mode.
# Leave blank to use HTTP in free mode and HTTPS in paid mode.
MARKETPLACE_BASE_URL=
SCOUT_MAX_BUDGET_UNITS=100000
BUYER_PRIVATE_KEY=
# Shared OpenAI-compatible key used by Scout and summary sellers when their
# service-specific API settings above are blank.
LLM_API_KEY=
# Per-agent *_PAY_TO addresses are optional when SELLER_PRIVATE_KEY is set; that
# wallet address is used for all built-in sellers until individual addresses are configured.

X402_FACILITATOR_URL=https://x402.org/facilitator
SELLER_DATABASE_PATH=./seller.sqlite
MARKETPLACE_DATABASE_PATH=./marketplace.sqlite
