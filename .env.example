PORT=4000
BUYER_ORIGIN=http://localhost:3001

# Free local testing by default. Set to true to require x402 payments.
SELLER_PAYMENTS_ENABLED=false

# Public Base Sepolia address that receives the movie seller's USDC payments.
MOVIE_SCRAPER_PAY_TO=0xREPLACE_WITH_40_HEX_BASE_SEPOLIA_ADDRESS
MOVIE_FACTS_PAY_TO=0xREPLACE_WITH_40_HEX_BASE_SEPOLIA_ADDRESS
MOVIE_SUMMARY_PAY_TO=0xREPLACE_WITH_40_HEX_BASE_SEPOLIA_ADDRESS
SHELF_SCRAPER_PAY_TO=0xREPLACE_WITH_40_HEX_BASE_SEPOLIA_ADDRESS
FX_RATES_PAY_TO=0xREPLACE_WITH_40_HEX_BASE_SEPOLIA_ADDRESS
HINDI_SUMMARY_PAY_TO=0xREPLACE_WITH_40_HEX_BASE_SEPOLIA_ADDRESS
FAKEJOBS_SCRAPER_PAY_TO=0xREPLACE_WITH_40_HEX_BASE_SEPOLIA_ADDRESS
FAKEJOBS_FACTS_PAY_TO=0xREPLACE_WITH_40_HEX_BASE_SEPOLIA_ADDRESS
FAKEJOBS_SUMMARY_PAY_TO=0xREPLACE_WITH_40_HEX_BASE_SEPOLIA_ADDRESS

# OpenAI-compatible chat-completions endpoint for the Hindi inference seller.
MOVIE_SUMMARY_API_URL=
MOVIE_SUMMARY_API_KEY=
MOVIE_SUMMARY_MODEL=
BOOK_SUMMARY_API_URL=
BOOK_SUMMARY_API_KEY=
BOOK_SUMMARY_MODEL=
JOB_SUMMARY_API_URL=
JOB_SUMMARY_API_KEY=
JOB_SUMMARY_MODEL=

# Set this to the public HTTPS origin from your tunnel when another computer needs
# to call the seller. Leave blank for same-computer testing.
PUBLIC_BASE_URL=

X402_FACILITATOR_URL=https://x402.org/facilitator
SELLER_DATABASE_PATH=./seller.sqlite
MARKETPLACE_DATABASE_PATH=./marketplace.sqlite
